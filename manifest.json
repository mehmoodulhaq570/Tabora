{
  "manifest_version": 3,
  "name": "Tabora",
  "description": "Organize bookmarks into beautiful pages and boards on every new tab.",
  "version": "3.0.1",
  "permissions": ["tabs", "storage", "clipboardWrite", "alarms"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "action": {
    "default_title": "Tabora",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Save the current tab to Tabora"
    }
  }
}
