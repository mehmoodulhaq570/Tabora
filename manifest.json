{
  "manifest_version": 3,
  "name": "Tabora",
  "description": "Organize bookmarks into beautiful pages and boards on every new tab.",
  "version": "3.0.2",
  "icons": {
    "16": "icons/tabora-16.png",
    "32": "icons/tabora-32.png",
    "48": "icons/tabora-48.png",
    "128": "icons/tabora-128.png"
  },
  "permissions": ["tabs", "storage", "clipboardWrite"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabora@lumilist.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "action": {
    "default_title": "Tabora",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tabora-16.png",
      "32": "icons/tabora-32.png",
      "48": "icons/tabora-48.png",
      "128": "icons/tabora-128.png"
    }
  },
  "background": {
    "scripts": ["shared.js", "background.js"],
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Save the current tab to Tabora"
    }
  }
}
